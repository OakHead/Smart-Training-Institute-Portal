@model Smart_Training_Institute_Portal.Models.Prerequisite

@{
    ViewData["Title"] = "Delete Prerequisite";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Prerequisite</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this prerequisite?
            </div>

            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Prerequisites", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)

                <div class="d-flex justify-content-between">
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            }
        </div>
    </div>
</div>