@model Smart_Training_Institute_Portal.Models.StudentProfile

@{
    ViewData["Title"] = "Performance Summary";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold">Performance Summary</h2>
        <p class="text-muted">View your grades, marks, GPA, and enrolled courses</p>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Student</h6>
                    <h4>@Model.User.FullName</h4>
                    <p class="mb-0">@Model.StudentId</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">GPA</h6>
                    <h4>
                        @(Model.GPA.HasValue? Model.GPA.Value.ToString("0.00") : "Not Set")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Enrolled Courses</h6>
                    <h4>@Model.Enrollments.Count()</h4>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Enrollments.Any())
    {
        <div class="alert alert-info">
            You are not enrolled in any courses yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                Grades
            </div>

            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course Code</th>
                            <th>Course</th>
                            <th>Department</th>
                            <th>Mark</th>
                            <th>Grade</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var enrollment in Model.Enrollments)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">
                                        @enrollment.Course.CourseCode
                                    </span>
                                </td>
                                <td>@enrollment.Course.Title</td>
                                <td>@enrollment.Course.Department?.Name</td>
                                <td>
                                    @(enrollment.Mark.HasValue? enrollment.Mark.Value.ToString("0.##") : "Not Set")
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(enrollment.Grade))
                                    {
                                        <span class="badge bg-success">@enrollment.Grade</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td>@enrollment.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>