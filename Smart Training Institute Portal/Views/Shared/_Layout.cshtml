<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Training Institute</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Smart_Training_Institute_Portal.styles.css" asp-append-version="true" />
</head>

<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Smart Training Institute
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Courses" asp-action="Catalog">Catalog</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="InstructorProfiles" asp-action="Index">Instructors</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    Admin
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="Index">Manage Users</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Courses" asp-action="Index">Manage Courses</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Prerequisites" asp-action="Index">Manage Prerequisites</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Departments" asp-action="Index">Manage Departments</a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Instructor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="InstructorProfiles" asp-action="MyCourses">
                                    My Courses
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    Student
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="StudentProfiles" asp-action="MyCourses">My Courses</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="StudentProfiles" asp-action="PerformanceSummary">Performance Summary</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="bg-white border-top text-muted py-3 mt-5">
        <div class="container text-center">
            &copy; 2026 - Smart Training Institute Portal
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>