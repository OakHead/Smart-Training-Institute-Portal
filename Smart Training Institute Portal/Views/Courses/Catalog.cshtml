@model IEnumerable<Smart_Training_Institute_Portal.Models.Course>

@{
    ViewData["Title"] = "Course Catalog";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Course Catalog</h1>
        <p class="text-muted">Explore our available training courses</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No published courses are available right now.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <span class="badge bg-primary mb-2">@item.CourseCode</span>

                            <h5 class="card-title fw-bold">@item.Title</h5>

                            <p class="card-text text-muted">
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    @item.Description
                                }
                                else
                                {
                                    <span>No description available.</span>
                                }
                            </p>

                            <hr />

                            <p class="mb-1">
                                <strong>Department:</strong>
                                @(item.Department != null ? item.Department.Name : "No Department")
                            </p>

                            <p class="mb-1">
                                <strong>Level:</strong> @item.Level
                            </p>

                            <p class="mb-1">
                                <strong>Credit Hours:</strong> @item.CreditHours
                            </p>

                            <p class="mb-1">
                                <strong>Hours / Week:</strong> @item.HoursPerWeek
                            </p>

                            <p class="mb-0">
                                <strong>Prerequisites:</strong>
                                @if (item.Prerequisites != null && item.Prerequisites.Any())
                                {
                                    <span>
                                        @string.Join(", ", item.Prerequisites.Select(p => p.Name))
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </p>
                        </div>

                        <div class="card-footer bg-white border-0">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary w-100">
                                View Course
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>