@model IEnumerable<Smart_Training_Institute_Portal.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Courses</h2>
            <p class="text-muted mb-0">Manage training institute courses</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create New Course
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Credit Hours</th>
                            <th>Hours / Week</th>
                            <th>Level</th>
                            <th>Department</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">
                                        @item.CourseCode
                                    </span>
                                </td>

                                <td>
                                    <strong>@item.Title</strong>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <span>@item.Description</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                </td>

                                <td>@item.CreditHours</td>

                                <td>@item.HoursPerWeek</td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        Level @item.Level
                                    </span>
                                </td>

                                <td>
                                    @if (item.Department != null)
                                    {
                                        @item.Department.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Department</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsPublished)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Draft</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-4">
                    No courses found.
                </div>
            }
        </div>
    </div>
</div>