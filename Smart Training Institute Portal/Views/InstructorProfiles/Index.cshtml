@model IEnumerable<Smart_Training_Institute_Portal.Models.InstructorProfile>

@{
    ViewData["Title"] = "Instructors";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Instructors</h1>
        <p class="text-muted">Meet our institute instructors and their specializations</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No instructors available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var instructor in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="mb-3">
                                @if (!string.IsNullOrWhiteSpace(instructor.ImageUrl))
                                {
                                    <img src="@instructor.ImageUrl"
                                         class="rounded-circle"
                                         style="width:100px;height:100px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto"
                                         style="width:100px;height:100px;font-size:32px;">
                                        @(instructor.User?.FullName?.Substring(0, 1).ToUpper() ?? "I")
                                    </div>
                                }
                            </div>

                            <h5 class="fw-bold">@instructor.User?.FullName</h5>

                            <p class="text-muted mb-1">
                                @instructor.Specialization
                            </p>

                            <p class="small text-muted">
                                @(string.IsNullOrWhiteSpace(instructor.Qualifications)
                                                        ? "No qualifications listed"
                                                        : instructor.Qualifications)
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@instructor.Id"
                               class="btn btn-outline-primary w-100">
                                View Instructor
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>