@model Smart_Training_Institute_Portal.Models.InstructorProfile

@{
    ViewData["Title"] = "Instructor Details";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Instructor Details</h4>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             class="rounded-circle mb-3"
                             style="width:140px;height:140px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                             style="width:140px;height:140px;font-size:48px;">
                            @(Model.User?.FullName?.Substring(0, 1).ToUpper() ?? "I")
                        </div>
                    }

                    <h4>@Model.User?.FullName</h4>
                    <p class="text-muted">@Model.InstructorId</p>
                </div>

                <div class="col-md-9">
                    <dl class="row">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.User?.Email</dd>

                        <dt class="col-sm-4">Specialization</dt>
                        <dd class="col-sm-8">@Model.Specialization</dd>

                        <dt class="col-sm-4">Qualifications</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Qualifications) ? "Not specified" : Model.Qualifications)
                        </dd>

                        <dt class="col-sm-4">Experience</dt>
                        <dd class="col-sm-8">
                            @(Model.Experience.HasValue? Model.Experience.Value.ToString("yyyy-MM-dd") : "Not specified")
                        </dd>

                        <dt class="col-sm-4">Office Location</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.OfficeLocation) ? "Not specified" : Model.OfficeLocation)
                        </dd>

                        <dt class="col-sm-4">Office Hours</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.OfficeHours) ? "Not specified" : Model.OfficeHours)
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Back to Instructors</a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>