@{
    ViewData["Title"] = "Add Student";
    var course = ViewBag.Course as Smart_Training_Institute_Portal.Models.Course;
}

<div class="mb-3">
    <label class="form-label">Available Students</label>

    @if (ViewBag.AvailableStudents != null && ViewBag.AvailableStudents.Count > 0)
    {
        @foreach (var student in ViewBag.AvailableStudents)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="studentProfileIds"
                       value="@student.Id" />

                <label class="form-check-label">
                    @student.User.FullName - @student.StudentId
                </label>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            All students are already enrolled in this course.
        </div>
    }
</div>

<div class="mb-3">
    <label class="form-label">Already Enrolled</label>

    @if (ViewBag.EnrolledStudents != null && ViewBag.EnrolledStudents.Count > 0)
    {
        <ul class="list-group">
            @foreach (var enrollment in ViewBag.EnrolledStudents)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        @enrollment.StudentProfile.User.FullName - @enrollment.StudentProfile.StudentId
                    </span>

                    <form asp-action="RemoveStudentEnrollment"
                          method="post"
                          class="d-inline">
                        <input type="hidden" name="enrollmentId" value="@enrollment.Id" />
                        <input type="hidden" name="courseId" value="@ViewBag.CourseId" />

                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Remove this student from the course?');">
                            Remove
                        </button>
                    </form>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="alert alert-info">
            No students enrolled yet.
        </div>
    }
</div>