@{
    ViewData["Title"] = "Add Student";
    var course = ViewBag.Course as Smart_Training_Institute_Portal.Models.Course;
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Add Student to Course</h4>
        </div>

        <div class="card-body">
            <h5>@course?.Title</h5>
            <p class="text-muted">@course?.CourseCode</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <form asp-action="AddStudent" method="post">
                <input type="hidden" name="courseId" value="@ViewBag.CourseId" />

                <div class="mb-3">
                    <label class="form-label">Student</label>
                    <select name="studentProfileId" class="form-select" asp-items="ViewBag.Students">
                        <option value="">-- Select Student --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="MyCourses" class="btn btn-secondary">Back</a>
                    <button type="submit" class="btn btn-primary">Add Student</button>
                </div>
            </form>
        </div>
    </div>
</div>